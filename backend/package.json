{
  "name": "t2-leave-api",
  "version": "2.0.0",
  "description": "GraphQL API for the T2 staff leave application",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup.js",
    "seed:demo": "node scripts/seed-demo.js",
    "migrate:legacy": "node scripts/migrate-legacy.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  }
}
